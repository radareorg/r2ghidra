NAME=pdgt and pdgtj single basic block
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
wx b82a000000c3
af
pdgt
pdgtj
EOF
EXPECT=<<EOF
0
  Basic Block 0 0x00000000-0x00000005
{"type":"graph","index":0,"children":[{"type":"basic","index":0,"space":"ram","start":0,"stop":5,"children":[]}]}
EOF
RUN

