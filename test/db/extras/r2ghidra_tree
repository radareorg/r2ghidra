NAME=pdgt and pdgtj distinguish a bottom-tested loop
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
wx 89f883e80175fbc3
af
pdgt
pdgtj~{children[0].children[1]}
EOF
EXPECT=<<EOF
0
  List block 0
    Basic Block 0 0x00000000-0x00000000
    Dowhile block 1
      Basic Block 1 0x00000002-0x00000005
    Basic Block 2 0x00000007-0x00000007
{"type":"dowhile","index":1,"children":[{"type":"basic","index":1,"space":"ram","start":2,"stop":5,"children":[]}]}
EOF
RUN

NAME=pdgtj returns a JSON error without an analyzed function
FILE=malloc://64
ARGS=-a x86 -b 64
CMDS=<<EOF
pdgtj
wx b82a000000c3
af
pdgtj @ 0x30
EOF
EXPECT=<<EOF
{"errors":["Ghidra Decompiler Error: No function at this offset"]}
{"errors":["Ghidra Decompiler Error: No function at this offset"]}
EOF
RUN

NAME=pdgtj preserves addresses above the exact floating-point integer range
FILE=malloc://64
ARGS=-a x86 -b 64 -m 0x20000000000001
CMDS=<<EOF
wx b82a000000c3
af
pdgtj~{children[0].start}
pdgtj~{children[0].stop}
EOF
EXPECT=<<EOF
9007199254740993
9007199254740998
EOF
RUN

