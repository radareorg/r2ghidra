# ConsoleApplication1.exe is radare2-testbins/pe/ConsoleApplication1.exe; the ELF
# fixtures are built by test/bins/Makefile.
NAME=ccode strips the Windows API-set DLL prefix from import names
FILE=bins/pe/ConsoleApplication1.exe
CMDS=<<EOF
aaaa
s sub.api_ms_win_crt_stdio_l1_1_0.dll__set_fmode
e r2ghidra.ccode=true
pdg~_set_fmode
EOF
EXPECT=<<EOF
void _set_fmode(void)
    _set_fmode();
EOF
RUN

NAME=ccode preserves the whole ELF import name
FILE=bins/elf/x86_64-pthread-lock.so
CMDS=<<EOF
aa
s entry0
e r2ghidra.ccode=true
pdg~pthread_mutex_lock
EOF
EXPECT=<<EOF
    pthread_mutex_lock(arg1);
EOF
RUN

NAME=ccode keeps leading underscores of sym.imp names
FILE=bins/hello-arm
CMDS=<<EOF
aa
s sym._start_main
e r2ghidra.ccode=true
pdg~__libc_init
EOF
EXPECT=<<EOF
    __libc_init(param_1,0,*(iRam00000424 + 0x418),&uStack_14);
EOF
RUN

NAME=ccode honors r2ghidra.casts and keeps necessary truncations
FILE=bins/elf/x86_64-cast-test.o
CMDS=<<EOF
aa
s sym.cast_test
e r2ghidra.ccode=true
e r2ghidra.casts=true
pdg~return
EOF
EXPECT=<<EOF
    return (int64_t)(int)arg1 + 0x100000000;
EOF
RUN

NAME=ccode turns the global.0xADDR names of inferred globals into C identifiers
FILE=bins/pe/ConsoleApplication1.exe
CMDS=<<EOF
aaa
e r2ghidra.ccode=true
pdg @ 0x4017e6~0x1f
pdg @ 0x4017e6~_register_onexit_function
EOF
EXPECT=<<EOF
    uVar2 = global_0x403004 & 0x1f;
        iVar1 = _register_onexit_function(&global_0x40333c,arg_8h);
EOF
RUN

NAME=ccode names a symbol global by its realname
FILE=bins/dectest64
CMDS=<<EOF
aaa
e r2ghidra.ccode=true
pdg @ sym.get_global_var~return
pdg @ entry.fini0~completed
EOF
EXPECT=<<EOF
    return global_var;
    if (completed_7392 == 0) {
        completed_7392 = 1;
EOF
RUN

NAME=ccode keeps a global named with a C keyword legal
FILE=bins/dectest64
CMDS=<<EOF
aaa
avg- @ 0x404050
avg uint32_t switch @ 0x404050
e r2ghidra.ccode=true
pdg @ sym.get_global_var~return
EOF
EXPECT=<<EOF
    return switch_;
EOF
RUN

NAME=ccode keeps a function named with a C keyword or a leading digit legal
FILE=bins/pe/ConsoleApplication1.exe
CMDS=<<EOF
aaa
e r2ghidra.ccode=true
afn while @ 0x401d6f
pdg @ 0x401d6f~while
pdg @ 0x40167d~while
afn sub.123 @ 0x401d6f
pdg @ 0x40167d~123
EOF
EXPECT=<<EOF
bool while_(void)
    iVar3 = while_();
    iVar3 = _123();
EOF
RUN

NAME=ccode makes local variable names legal C identifiers
FILE=bins/dectest64
CMDS=<<EOF
aaa
s main
afvn while var_20h
afvn a-b var_24h
e r2ghidra.ccode=true
pdg~while
pdg~a_b
EOF
EXPECT=<<EOF
    int64_t while_;
    Aeropause(&while_,argc,argv);
    int32_t a_b;
EOF
RUN

NAME=ccode makes prototype argument names legal C identifiers
